# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO TỬ VI BACKEND (DOCKER / DOCKGE)
# ==============================================================================

# Cổng và IP ánh xạ phía Host:
# - Mặc định khi test local trên máy cá nhân: HOST_PORT=8000 (bind 0.0.0.0:8000)
# - Trên VPS Linux (khuyên dùng khi chạy sau Caddy / Nginx / Cloudflare Tunnel):
#   HOST_PORT=127.0.0.1:8000
#   (Compose sẽ bind dạng 127.0.0.1:8000:8000, chỉ lắng nghe nội bộ trên VPS,
#   tuyệt đối không mở cổng 8000 trực tiếp ra Internet).
HOST_PORT=127.0.0.1:8000

# Phiên bản Image tag (dùng khi build hoặc pull image)
TAG=latest
