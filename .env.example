# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO TỬ VI BACKEND
# ==============================================================================

# Cổng ánh xạ phía Host (máy chủ hoặc VPS)
# Mặc định: 8000 (bind tất cả interface 0.0.0.0:8000)
# Trên VPS chạy sau Reverse Proxy (Nginx / Caddy / Cloudflare Tunnel),
# nên đổi thành 127.0.0.1:8000 để không mở cổng trực tiếp ra Internet:
HOST_PORT=8000

# Phiên bản Image tag (dùng khi build hoặc pull)
TAG=latest
